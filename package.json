{
  "name": "eslint-plugin-lintlord",
  "version": "1.2.0",
  "description": "A collection of useful ESLint rules for cleaner, more maintainable TypeScript code",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npx tsx ./src/main.ts",
    "build": "tsup",
    "prepack": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "cross-env TIMING=1 npx eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:debug": "npm run lint -- --debug",
    "format:md": "npx prettier --write \"**/*.md\"",
    "typecheck": "npx tsc --noEmit",
    "test": "npx vitest",
    "test:run": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "bump-version": "npx tsx ./scripts/bump-version.script.ts && npm audit fix",
    "parse-llm-response": "npx tsx ./scripts/split-plain-code.wrap.ts",
    "after-parse-llm-response": "npx tsx ./scripts/create-auto-ts-paths.script.ts && npm run lint:fix && npm run format:md",
    "format": "npx prettier . --write"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "typescript",
    "lintlord",
    "inline-types",
    "naming",
    "code-quality"
  ],
  "author": "Dmytro Vakulenko",
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^8 || ^9 || ^10",
    "typescript": "^4 || ^5 || ^6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.1"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.26",
    "@dword-design/eslint-plugin-import-alias": "^8.1.7",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/rule-tester": "^8.59.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.10",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "eslint": "^10.0.3",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-naming": "^1.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "json5": "^2.2.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^2.0.0-alpha.15",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "^10"
    },
    "eslint-plugin-import": {
      "eslint": "^10"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrSmile444/eslint-plugin-lintlord.git"
  },
  "homepage": "https://drsmile444.github.io/eslint-plugin-lintlord/",
  "bugs": {
    "url": "https://github.com/DrSmile444/eslint-plugin-lintlord/issues"
  }
}
